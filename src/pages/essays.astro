---
import MainGridLayout from '../layouts/MainGridLayout.astro';
import EssayPreview from '../components/EssayPreview.astro';
import { getSortedPosts } from '../utils/content-utils';
const essays = (await getSortedPosts()).filter(entry => entry.data.category === '随笔');
---
<MainGridLayout title="随笔" description="Wangles 写下的文字。">
  <section class="card-base essay-index" data-pagefind-body>
    <h1>随笔</h1>
    <div class="essay-list">{essays.map(post => <EssayPreview post={post} />)}</div>
  </section>
</MainGridLayout>

<style>
  .essay-index { padding: clamp(20px, 4vw, 48px); }
  h1 { font: 400 clamp(28px, 5vw, 46px)/1.2 'LXGW WenKai Screen', 'Noto Serif SC', serif; }
  .essay-list { display: grid; gap: 24px; margin-top: 24px; }
</style>
