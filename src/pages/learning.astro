---
import MainGridLayout from '../layouts/MainGridLayout.astro';
import PostPage from '../components/PostPage.astro';
import { getSortedPosts } from '../utils/content-utils';
const notes = (await getSortedPosts()).filter(entry => ['论文复现', '学习笔记'].includes(entry.data.category || ''));
---
<MainGridLayout title="知识笔记" description="Wangles 的论文复现、方法理解与学习笔记。">
  <section class="card-base welcome"><p class="welcome-label">学习与复现</p><h1>知识笔记</h1><p>这里记录读论文、尝试复现和整理学习资料时留下的笔记，目前主要是 Sonata 复现与数学建模。</p></section>
  <PostPage page={{data:notes}} />
</MainGridLayout>
