---
import MainGridLayout from '../layouts/MainGridLayout.astro';
import { favorites } from '../data/favorites';
import { musicians } from '../data/musicians';
import { workDetails } from '../data/work-details';
import { workReviews } from '../data/work-reviews';
import '../styles/favorites-journal.css';
const entries = favorites.map((work,index) => ({work, index:index+1, detail:workDetails[work.slug], review:workReviews[work.slug]}));
---
<MainGridLayout title="喜欢的作品" description="Wangles 收藏的电影、动画与音乐">
  <div class="card-base favorites-journal" data-pagefind-body>
    <header class="journal-header">
      <p class="journal-caption">Wangles / Favorites</p>
      <h1>喜欢的作品</h1>
      <p>看过的，听过的，偶尔还会重新翻出来。</p>
    </header>
    <section class="journal-section" aria-labelledby="journal-films-title">
      <div class="journal-section-heading"><h2 id="journal-films-title">电影与动画</h2><span>08</span></div>
      <div class="journal-film-list">
        {entries.map(({work,index,detail,review}) => (
          <article class="journal-film">
            <span class="journal-film-number">{String(index).padStart(2,'0')}</span>
            <a href={work.href} class="journal-film-poster" aria-label={`阅读《${work.title}》的影评`}>
              <img src={work.cover} alt={`《${work.title}》作品海报`} width="600" height="858" loading="lazy" decoding="async" />
            </a>
            <div class="journal-film-body">
              <p class="journal-film-meta">{detail.kind}{detail.year && <span> · {detail.year}</span>}</p>
              <h3><a href={work.href}>{work.title}</a></h3>
              {work.originalTitle && <p class="journal-film-original">{work.originalTitle}</p>}
              <p class="journal-film-lead">{review.lead}</p>
              <a href={work.href} class="journal-film-read">读影评 <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="journal-section journal-music" aria-labelledby="journal-music-title">
      <div class="journal-section-heading"><h2 id="journal-music-title">音乐</h2><span>07</span></div>
      <div class="journal-musician-grid">
        {musicians.map(artist => (
          <a class="journal-musician" href={artist.href} aria-label={`查看${artist.name}`}>
            <img src={artist.photo} alt={`${artist.name}照片`} width="700" height="875" loading="lazy" decoding="async" />
            <span>{artist.name}</span>
          </a>
        ))}
      </div>
    </section>
    <section class="journal-character" aria-label="喜欢的角色">
      <img src="/assets/muichiro-hero.png" alt="时透无一郎插画" width="1536" height="1024" loading="lazy" />
      <div><p class="journal-caption">Favorite character</p><h2>时透无一郎</h2><p>《鬼灭之刃》的霞柱。这个小站，也留了一点他的雾青色。</p></div>
    </section>
    <details class="image-credits journal-credits">
      <summary>图片来源</summary><p>海报和歌手照片版权归原权利人所有。</p>
      <ul>{favorites.map(work => <li><a href={work.source} target="_blank" rel="noopener noreferrer">{work.title} ↗</a></li>)}{musicians.map(artist => <li><a href={artist.source} target="_blank" rel="noopener noreferrer">{artist.name} ↗</a></li>)}</ul>
      <p>时透无一郎配图为 AI 生成的角色插画。</p>
    </details>
  </div>
</MainGridLayout>
