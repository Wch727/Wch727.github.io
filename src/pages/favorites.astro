---
import MainGridLayout from '../layouts/MainGridLayout.astro';
const favorites = [
 ['新海诚的作品','天空、雨与相遇','你的名字。 · 天气之子 · 秒速五厘米 · 言叶之庭'],
 ['鬼灭之刃','时透无一郎','喜欢霞柱，也给这个小站留一点雾青色。'],
 ['萤火之森','森林里的夏天','喜欢的动画电影。'],
 ['间谍过家家','间谍过家家','我的动画片单之一。'],
 ['刀剑神域','刀剑神域','也喜欢这个关于虚拟世界的故事。'],
 ['奶龙','还有奶龙！','喜欢的作品里，也给奶龙留一个位置。']
];
---
<MainGridLayout title="喜欢的作品" description="Wangles 喜欢的动画、电影与角色">
 <section class="card-base collection">
  <p class="welcome-label">代码之外</p><h1 class="collection-title">一些喜欢，放在这里。</h1>
  <p class="collection-intro">电影、动画，还有喜欢的角色。</p>
  <div class="shelf">{favorites.map(([label,title,description])=><article class="shelf-item"><small>{label}</small><h2>{title}</h2><p>{description}</p></article>)}</div>
  <p class="shelf-note">这份片单没有排名。以后遇到喜欢的作品，再慢慢添进来。</p>
 </section>
</MainGridLayout>
