---
import { getSortedPosts } from '../utils/content-utils';
import { getPostUrlBySlug } from '../utils/url-utils';
import FavoritePreview from './FavoritePreview.astro';
import '../styles/home.css';
const all = await getSortedPosts();
const featuredProjects = ['connect6', 'algorithm-notebook'];
const order = [
  ...featuredProjects,
  'video-transcriber',
  'claude-statusline',
  'claude-net-tools',
  'loopvl-local-deploy',
  'kaggriculture-agent',
  'heart-harbor',
];
const projects = order
  .map(slug => all.find(post => post.slug === slug))
  .filter(post => post !== undefined);
const featuredCount = projects.filter(post => featuredProjects.includes(post.slug)).length;
const openSourceNote = all.find(post => post.slug === 'computer-apply');
const notes = all.filter(p => ['论文复现', '学习笔记'].includes(p.data.category || ''));
const covers: Partial<Record<string, {file: string; alt: string}>> = {
  'heart-harbor': {file:'heart-harbor.webp',alt:'心港首页，展示陪伴聊天和情绪签到入口'},
  'connect6': {file:'connect6.svg',alt:'六子棋棋盘与策略价值搜索示意'},
  'loopvl-local-deploy': {file:'loopvl.svg',alt:'LoopVL 图片输入、推理和按需释放流程'},
  'algorithm-notebook': {file:'algorithm.svg',alt:'算法手册章节与并查集代码排版'},
  'claude-statusline': {file:'statusline.svg',alt:'终端状态栏的上下文、Token 与用量账本结构'},
  'claude-net-tools': {file:'net-tools.svg',alt:'搜索、网页读取与文档快照续读流程'},
  'video-transcriber': {file:'video-transcriber.webp',alt:'Video Text Extractor 真实桌面转写工作台截图'},
  'kaggriculture-agent': {file:'kaggriculture.svg',alt:'农田与 observation、policy、action 决策流程示意'},
  'long-march': {file:'long-march.svg',alt:'长征主题作品路线导览与知识问答示意'},
};
const essay = all.find(p => p.slug === 'rain-and-cherry-blossoms');
---
<div class="home-overview">
  <header class="home-intro">
    <div>
      <h1>你好，我是 <span class="home-name">Wangles</span></h1>
      <p class="home-intro-line">在晴空下，慢慢探索。</p>
      <p class="home-bio">在中国人民大学高瓴人工智能学院读本科。平时参加 ICPC / CCPC，也喜欢尝试强化学习、Agent 和一些自己用得上的小工具。2026 CCPC 乐山站铜牌。</p>
      <nav aria-label="个人链接">
        <a href="/about/">关于我 <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/Wch727" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    <a class="home-portrait" href="/about/" aria-label="关于 Wangles"><img src="/assets/muichiro-hero.png" alt="时透无一郎插画" width="360" height="300" /></a>
  </header>
  <nav class="home-contents" aria-label="首页内容"><a href="#projects">项目 <span>↓</span></a><a href="#writing">笔记与随笔 <span>↓</span></a><a href="#favorites">喜欢的作品 <span>↓</span></a></nav>
  <section id="projects" class="home-projects" aria-labelledby="home-project-title">
    <div class="home-section-heading"><h2 id="home-project-title">项目</h2><a href="/archive/">全部文章 ↗</a></div>
    <div class="home-project-grid">
      {projects.map((post, index) => {
        const cover = covers[post.slug];
        const featured = featuredProjects.includes(post.slug);
        return (
          <>
            {index === featuredCount && (
              <div class="home-project-break">
                <span>其他项目</span>
              </div>
            )}
            <article class:list={['home-project', {
            'home-project-featured': featured,
            'home-project-compact': !featured,
          }]}>
            {cover && (
              <figure class="home-project-cover">
                <img src={`/assets/projects/${cover.file}`} alt={cover.alt} width="1000" height="600" loading="lazy" decoding="async" />
              </figure>
            )}
            <div class="home-project-body">
              <h3><a href={getPostUrlBySlug(post.slug)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            </article>
          </>
        );
      })}
    </div>
    {openSourceNote && (
      <aside class="home-source-note" aria-label="开源项目笔记">
        <span>开源项目笔记</span>
        <a href={getPostUrlBySlug(openSourceNote.slug)}>{openSourceNote.data.title} ↗</a>
      </aside>
    )}
  </section>
  <section id="writing" class="home-writing" aria-labelledby="home-writing-title">
    <div class="home-section-heading"><div><p class="home-eyebrow">NOTES & WORDS</p><h2 id="home-writing-title">知识笔记与随笔</h2></div><a href="/learning/">知识笔记 ↗</a></div>
    <div class="home-writing-grid"><div class="home-notes">{notes.map(post => <a href={getPostUrlBySlug(post.slug)}><span>{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="home-read">阅读笔记 ↗</span></a>)}</div>
    {essay && <a class="home-essay" href={getPostUrlBySlug(essay.slug)}><img src="/assets/essay-cherry-rain.webp" alt="雨中的樱花" width="900" height="600" loading="lazy" /><div><span>随笔 · 2025.5</span><h3>雨落无声，樱逝无痕</h3><p>关于成年、相遇，和那些留在心里的事。</p><span class="home-read">读这篇随笔 ↗</span></div></a>}
    </div>
  </section>
  <div id="favorites"><FavoritePreview /></div>
</div>
